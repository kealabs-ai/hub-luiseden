# Copy this file to .env locally and replace every placeholder.
# Never commit .env or real credentials to the repository.

SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

luis_ed_DB_HOST=your-database-host
luis_ed_DB_PORT=3306
luis_ed_DB_NAME=your-database-name
luis_ed_DB_USER=your-database-user
luis_ed_DB_PASSWORD=replace-with-your-database-password
