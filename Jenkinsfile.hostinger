pipeline {
    agent any

    environment {
        REGISTRY             = "registry.luiseden.io"
        IMAGE_PREFIX         = "${REGISTRY}/luiseden"
        TAG                  = "${env.BUILD_NUMBER}"
        COMPOSE_PROJECT_NAME = "luiseden"
    }

    stages {

        stage('Environment Setup') {
            steps {
                script {
                    echo "=== CONFIGURAÇÃO DO AMBIENTE HOSTINGER ==="

                    sh "docker --version"
                    sh "docker info --format 'Server Version: {{.ServerVersion}}'"

                    sh """
                        if ! command -v docker-compose &> /dev/null; then
                            echo 'Instalando docker-compose...'
                            mkdir -p \$HOME/bin
                            curl -L "https://github.com/docker/compose/releases/download/v2.24.0/docker-compose-linux-x86_64" -o \$HOME/bin/docker-compose
                            chmod +x \$HOME/bin/docker-compose
                            export PATH=$HOME/bin:$PATH
                        fi

                        export PATH=\$HOME/bin:\$PATH
                        docker-compose --version
                    """

                    sh """
                        echo "Recursos do sistema:"
                        df -h .
                        free -h
                        whoami
                        pwd
                    """
                }
            }
        }

        stage('Cleanup') {
            steps {
                script {
                    echo "=== LIMPEZA HOSTINGER ==="

                    sh """
                        export PATH=\$HOME/bin:\$PATH

                        docker-compose -p ${COMPOSE_PROJECT_NAME} down --remove-orphans 2>/dev/null || true

                        docker ps -aq --filter "name=luiseden" --filter "name=eden-svc-" | xargs -r docker rm -f 2>/dev/null || true

                        docker image prune -f --filter "until=24h" || true
                        docker container prune -f || true
                        docker network prune -f || true

                        echo "Espaço após limpeza:"
                        df -h .
                    """
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
                sh "ls -la"
            }
        }

        stage('Build Images') {
            steps {
                script {
                    echo "=== BUILD SEQUENCIAL PARA HOSTINGER ==="

                    def services = [
                        'svc-auth', 'svc-catalogo', 'svc-vendas',
                        'svc-financeiro', 'svc-orcamentos', 'svc-manutencao',
                        'svc-fornecedores', 'svc-usuarios'
                    ]

                    services.each { svc ->
                        echo "Building ${svc}..."
                        sh """
                            docker build -t ${IMAGE_PREFIX}/${svc}:${TAG} ./${svc}
                            docker tag ${IMAGE_PREFIX}/${svc}:${TAG} ${IMAGE_PREFIX}/${svc}:latest
                        """
                        sleep(5)
                    }
                }
            }
        }

        stage('Test Images') {
            steps {
                script {
                    echo "=== TESTE DAS IMAGENS ==="

                    sh "docker images | grep luiseden"

                    sh """
                        docker run --rm \
                          -e luis_ed_DB_HOST=localhost \
                          -e luis_ed_DB_PORT=3306 \
                          -e luis_ed_DB_NAME=test \
                          -e luis_ed_DB_USER=test \
                          -e luis_ed_DB_PASSWORD=test \
                          -e SECRET_KEY=test-key \
                          ${IMAGE_PREFIX}/svc-auth:${TAG} \
                          python -c "import main; print('svc-auth: OK')"
                    """
                }
            }
        }

        stage('Deploy') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                }
            }
            steps {
                    withCredentials([
                        string(credentialsId: 'luiseden-secret-key', variable: 'SECRET_KEY'),
                        string(credentialsId: 'luiseden-db-host', variable: 'luis_ed_DB_HOST'),
                        string(credentialsId: 'luiseden-db-port', variable: 'luis_ed_DB_PORT'),
                        string(credentialsId: 'luiseden-db-name', variable: 'luis_ed_DB_NAME'),
                        string(credentialsId: 'luiseden-db-user', variable: 'luis_ed_DB_USER'),
                        string(credentialsId: 'luiseden-db-password', variable: 'luis_ed_DB_PASSWORD')
                    ]) {
                    script {
                        echo "=== DEPLOY HOSTINGER ==="

                        sh '''
                            set -eu
                            for variable in SECRET_KEY luis_ed_DB_HOST luis_ed_DB_PORT luis_ed_DB_NAME luis_ed_DB_USER luis_ed_DB_PASSWORD; do
                                if [ -z "$(printenv "$variable" || true)" ]; then
                                    echo "Missing required deployment variable: $variable"
                                    exit 1
                                fi
                            done

                            cat > .env << EOF
SECRET_KEY=${SECRET_KEY}
luis_ed_DB_HOST=${luis_ed_DB_HOST}
luis_ed_DB_PORT=${luis_ed_DB_PORT}
luis_ed_DB_NAME=${luis_ed_DB_NAME}
luis_ed_DB_USER=${luis_ed_DB_USER}
luis_ed_DB_PASSWORD=${luis_ed_DB_PASSWORD}
REGISTRY=${REGISTRY}
TAG=${TAG}
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME}
EOF
                        '''

                        sh '''
                            export PATH=$HOME/bin:$PATH
                            export SECRET_KEY="$SECRET_KEY"
                            export luis_ed_DB_HOST="$luis_ed_DB_HOST"
                            export luis_ed_DB_PORT="$luis_ed_DB_PORT"
                            export luis_ed_DB_NAME="$luis_ed_DB_NAME"
                            export luis_ed_DB_USER="$luis_ed_DB_USER"
                            export luis_ed_DB_PASSWORD="$luis_ed_DB_PASSWORD"
                            export REGISTRY="$REGISTRY"
                            export TAG="$TAG"
                            export COMPOSE_PROJECT_NAME="$COMPOSE_PROJECT_NAME"

                            echo "Validando configuração do Compose..."
                            docker-compose -p "$COMPOSE_PROJECT_NAME" config --quiet

                            echo "Fazendo deploy..."
                            docker-compose -p ${COMPOSE_PROJECT_NAME} up -d --build --remove-orphans

                            echo "Aguardando inicialização..."
                            sleep 45
                        '''
                    }
                }
            }
        }

        stage('Health Check') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                }
            }
            steps {
                script {
                    echo "=== VERIFICAÇÃO DE SAÚDE ==="

                    sh """
                        export PATH=\$HOME/bin:\$PATH

                        echo "Status dos containers:"
                        docker-compose -p ${COMPOSE_PROJECT_NAME} ps

                        echo "Containers em execução:"
                        docker ps --format "table {{.Names}}\\t{{.Status}}\\t{{.Ports}}"

                        echo "Verificando svc-auth..."
                        for i in {1..20}; do
                            AUTH_STATUS=$(docker inspect --format='{{.State.Health.Status}}' eden-svc-auth 2>/dev/null || echo "missing")
                            echo "Tentativa $i/20: svc-auth=$AUTH_STATUS"
                            if [ "$AUTH_STATUS" = "healthy" ]; then
                                break
                            fi
                            if [ "$i" -eq 20 ]; then
                                echo "[ERRO] svc-auth não ficou healthy"
                                docker-compose -p ${COMPOSE_PROJECT_NAME} logs --tail=100 svc-auth || true
                                exit 1
                            fi
                            sleep 3
                        done

                        echo "Verificando porta 9001..."
                        netstat -tlnp | grep :9001 || ss -tlnp | grep :9001 || echo "Porta não encontrada"
                    """

                    sh """
                        echo 'Testando conectividade...'

                        for i in {1..20}; do
                            echo "Tentativa \$i/20..."

                            if curl -fsS --connect-timeout 3 --max-time 5 http://localhost:9001/health >/dev/null 2>&1; then
                                echo '[OK] svc-auth respondendo em :9001!'
                                break
                            elif [ \$i -eq 20 ]; then
                                echo '[ERRO] svc-auth não respondeu após 20 tentativas'

                                export PATH=\$HOME/bin:\$PATH
                                echo "Logs do svc-auth:"
                                docker-compose -p ${COMPOSE_PROJECT_NAME} logs --tail=100 svc-auth || true

                                echo "Status detalhado:"
                                docker ps -a --filter "name=luiseden"

                                exit 1
                            else
                                sleep 6
                            fi
                        done
                    """

                    sh """
                        echo 'Testando login...'

                        RESPONSE=\$(curl -s -w "%{http_code}" --connect-timeout 5 --max-time 10 \\
                            -X POST http://localhost:9000/v1/eden/auth/login \\
                            -H "Content-Type: application/json" \\
                            -d '{"email": "admin@luiseden.com.br", "senha": "admin123"}' 2>/dev/null || echo "000")

                        HTTP_CODE="\${RESPONSE: -3}"

                        if [ "\$HTTP_CODE" = "200" ]; then
                            echo '[OK] Login funcionando!'
                        else
                            echo '[AVISO] Login retornou código: '\$HTTP_CODE
                        fi
                    """
                }
            }
        }

    }

    post {
        always {
            script {
                sh "rm -f .env || true"

                sh """
                    export PATH=\$HOME/bin:\$PATH

                    echo "=== STATUS FINAL ==="
                    docker ps --format "table {{.Names}}\\t{{.Status}}\\t{{.Ports}}" --filter "name=luiseden" || true

                    echo "=== RECURSOS ==="
                    df -h . || true
                    docker system df || true
                """
            }
        }
        success {
            echo "[SUCESSO] Deploy concluído na Hostinger!"
            echo "[INFO] API: http://localhost:9000/v1/eden/"
            echo "[INFO] Docs: http://localhost:9000/docs"
            echo "[INFO] Login: admin@luiseden.com.br / admin123"
        }
        failure {
            echo "[ERRO] Deploy falhou - diagnóstico:"
            sh """
                export PATH=\$HOME/bin:\$PATH

                echo "=== LOGS DE ERRO ==="
                docker-compose -p ${COMPOSE_PROJECT_NAME} logs --tail=30 hubluiseden 2>/dev/null || true
                docker-compose -p ${COMPOSE_PROJECT_NAME} logs --tail=30 svc-auth 2>/dev/null || true

                echo "=== CONTAINERS ==="
                docker ps -a --filter "name=luiseden" || true

                echo "=== RECURSOS ==="
                df -h || true
                free -h || true
            """
        }
    }
}
